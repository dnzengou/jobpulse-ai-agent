{
  "name": "jobpulse-ai-agent",
  "description": "Your AI job-search wingman — find roles, polish your resume, research companies, tailor applications, and apply with browser assistance — all from Claude Code.",
  "version": "0.4.0",
  "author": {
    "name": "dnzengou",
    "url": "https://github.com/dnzengou"
  },
  "homepage": "https://jobpulse-ai-agent.vercel.app",
  "repository": "https://github.com/dnzengou/jobpulse-ai-agent",
  "bugs": {
    "url": "https://github.com/dnzengou/jobpulse-ai-agent/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "jobs",
    "resume",
    "job-search",
    "career",
    "cover-letter",
    "interview-prep",
    "salary-negotiation",
    "linkedin",
    "mcp",
    "claude-code",
    "ai-agent"
  ],
  "mcpServers": {
    "jobspy": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/start-mcp.mjs"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-deps.mjs\""
          }
        ]
      }
    ]
  }
}
